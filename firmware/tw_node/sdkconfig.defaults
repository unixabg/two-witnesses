# tw_node build settings: Espressif's csi_send/csi_recv defaults, plus:
#  - console (logs) on the UART/COM port only, so the native USB port carries data alone
#  - warnings-only logging
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_OFFSET=0xa000
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=128
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# 2.2: FreeRTOS counts each task's time (esp_timer, 1 MHz), for each core's load in TWF
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# 2.2: the 8 MB octal PSRAM of the ESP32-S3-WROOM-1 N16R8 on; start without it if absent
# (another module variant). Used only when asked for (heap_caps_malloc): everything else,
# Wi-Fi included, stays in internal memory as before
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
